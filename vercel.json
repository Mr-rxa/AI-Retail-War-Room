{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/css/(.*)",
      "dest": "/frontend/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/frontend/js/$1"
    },
    {
      "src": "/components/(.*)",
      "dest": "/frontend/components/$1"
    },
    {
      "src": "/dashboard",
      "dest": "/frontend/pages/dashboard.html"
    },
    {
      "src": "/customer",
      "dest": "/frontend/pages/customer.html"
    },
    {
      "src": "/forecast",
      "dest": "/frontend/pages/forecast.html"
    },
    {
      "src": "/anomaly",
      "dest": "/frontend/pages/anomaly.html"
    },
    {
      "src": "/insights",
      "dest": "/frontend/pages/insights.html"
    },
    {
      "src": "/advisor",
      "dest": "/frontend/pages/advisor.html"
    },
    {
      "src": "/upload",
      "dest": "/frontend/pages/upload.html"
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}